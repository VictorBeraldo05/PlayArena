SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
# Local development. On Render, use the three production origins documented in docs/deployment.md.
WEB_ORIGINS=http://localhost:3000
# Secure by default. Set true only in local development when API docs are needed.
API_DOCS_ENABLED=false
TRUST_PROXY_HEADERS=false
ANALYTICS_RATE_LIMIT_PER_MINUTE=120
AVAILABILITY_RATE_LIMIT_PER_MINUTE=60
RESERVATION_RATE_LIMIT_PER_MINUTE=10
CHECKOUT_RATE_LIMIT_PER_MINUTE=10
PAYMENT_WEBHOOK_RATE_LIMIT_PER_MINUTE=600
OWNER_MUTATION_RATE_LIMIT_PER_MINUTE=90
MAX_REQUEST_BODY_BYTES=65536
EMAIL_NOTIFICATIONS_ENABLED=false
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_URL=http://localhost:3000
EMAIL_REQUEST_TIMEOUT_SECONDS=5
# Payments are disabled by default. Never put real credentials in this file.
# TEST: PAYMENT_PROVIDER=mercado_pago, PAYMENT_ENV=test, PAYMENT_SANDBOX_ENABLED=true,
#       MERCADO_PAGO_TEST_SELLER_ID=<test seller ID>, test Access Token and test webhook secret.
# REAL: PAYMENT_PROVIDER=mercado_pago, PAYMENT_ENV=production, PAYMENT_SANDBOX_ENABLED=false,
#       MERCADO_PAGO_LIVE_SELLER_ID=<optional live seller ID>, production Access Token and webhook secret.
# Real Pix stays blocked until PAYMENT_PRODUCTION_ENABLED=true.
# PAYMENT_PRODUCTION_TEST_ENABLED=true activates controlled homologation.
# Its optional allowed user ID applies only in controlled mode; empty means no user restriction.
BOOKING_ADVANCE_AMOUNT=5.00
BOOKING_PAYMENT_ENABLED=true
PAYMENT_HOLD_MINUTES=10
PAYMENT_PROVIDER=disabled
PAYMENT_ENV=test
PAYMENT_SANDBOX_ENABLED=false
PAYMENT_PRODUCTION_ENABLED=false
PAYMENT_PRODUCTION_TEST_ENABLED=false
PAYMENT_PRODUCTION_TEST_ALLOWED_USER_ID=
# Temporary expiry diagnostics: set only for one payment UUID, then remove.
# PAYMENT_DEBUG_PAYMENT_ID=00000000-0000-0000-0000-000000000000
PAYMENT_WEBHOOK_SECRET=
MERCADO_PAGO_ACCESS_TOKEN=
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_TEST_SELLER_ID=
MERCADO_PAGO_LIVE_SELLER_ID=
MERCADO_PAGO_HTTP_TIMEOUT_SECONDS=5

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_API_URL=http://localhost:8000

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
